# Server Port Configuration
PORT=5000
APP_URL=http://localhost:5000

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=bus_booking_db

# Admin Credentials (Auto-seeded on server startup)
ADMIN_EMAIL=admin@busticket.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=9000000000

# JWT Token Secrets & Expirations
JWT_ACCESS_SECRET=your_jwt_access_token_secret_key_123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_456
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Configuration (Nodemailer for OTP & Ticket Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
FROM_EMAIL=your_email@gmail.com

# OTP Expiration Time (Minutes)
OTP_EXPIRY_MINUTES=1

# Default System Configuration Parameters
DEFAULT_MAX_WALLET_USAGE_PERCENT=20
DEFAULT_REFERRAL_REWARD_AMOUNT=500
